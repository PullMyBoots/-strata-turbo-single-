+    const float d=__fdividef(amax,127.0f);
+    const int8_t q=amax==0.0f?0:roundf(__fdividef(xi,d));
+    xq[idx/32].qs[idx%32]=q;
+    if(idx%32==0)xq[idx/32].ds=__floats2half2_rn(d,sum);
