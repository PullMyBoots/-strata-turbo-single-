+// An exact two-stage HC read: each down CTA computes the original norm tree
+// locally, then consumes each normalized stream before reusing its tile.
+// It trades redundant cached input reads for the separate norm launch and
+// its device-wide dependency. Only CTA 0 exports xn/rs; all other CTAs use
+// their own identical shared-memory values, with no inter-CTA spin or race.
+template<int TOKENS>
+__global__ void __launch_bounds__(THREADS*TOKENS) gr_norm_down_exact_kernel(GrMulti m) {
+    extern __shared__ __align__(16) float tile[];
+    __shared__ float part[TOKENS][WARPS], scale[TOKENS];
+    constexpr int TQ=N/8/32;
+    const int token=threadIdx.x/THREADS, tid=threadIdx.x%THREADS;
+    const int lane=tid&31, warp=tid>>5;
+    const bool inject=blockIdx.x==DOWN_BLOCKS;
+    const int row=inject?warp:blockIdx.x*WARPS+warp;
+    const bool active=!(inject && (!m.a[0].w_inject || warp>=HC));
+    const uint16_t* wr=(inject?m.a[0].w_inject:m.a[0].w_down);
+    const uint4* w4=wr?reinterpret_cast<const uint4*>(wr+(size_t)(active?row:0)*D):nullptr;
+    const auto& a=m.a[token];
+    float acc=0.0f;
+    for(int c=0;c<HC;++c) {
+        uint4 weights[TQ];
+        if(active) {
+            #pragma unroll
+            for(int q=0;q<TQ;++q)weights[q]=__ldg(w4+c*(N/8)+lane+32*q);
+        }
+        const float gw=a.apply?2.0f*sigmoidf_(a.inj_prev[c]/(float)HC):0.0f;
+        float ss=0.0f;
+        for(int i=tid*4;i<D;i+=THREADS*4) {
+            if(i/N!=c)continue;
+            const int d=i-c*N;
+            float4 r=*reinterpret_cast<const float4*>(a.R+i);
+            if(a.apply) {
+                const float4 b=*reinterpret_cast<const float4*>(a.bo_prev+d);
+                r.x=fmaf(b.x,gw,r.x);r.y=fmaf(b.y,gw,r.y);
+                r.z=fmaf(b.z,gw,r.z);r.w=fmaf(b.w,gw,r.w);
+            }
+            const float sq=r.x*r.x+r.y*r.y+r.z*r.z+r.w*r.w;
+            ss+=sq;
+            const float4 gamma=*reinterpret_cast<const float4*>(a.w_norm+i);
+            *reinterpret_cast<float4*>(tile+(size_t)token*N+d)=
+                make_float4(__fmul_rn(r.x,gamma.x),__fmul_rn(r.y,gamma.y),
+                            __fmul_rn(r.z,gamma.z),__fmul_rn(r.w,gamma.w));
+        }
+        const float sum=warp_sum(ss);
+        if(lane==0)part[token][warp]=sum;
+        __syncthreads();
+        if(tid==0) {
+            float total=0.0f;
+            for(int w=0;w<WARPS;++w)total+=part[token][w];
+            scale[token]=rsqrtf(total/(float)N+a.eps);
+            if(blockIdx.x==0)a.rs[c]=scale[token];
+        }
+        __syncthreads();
+        const float rs=scale[token];
+        for(int d=tid;d<N;d+=THREADS) {
+            const float x=__fmul_rn(tile[(size_t)token*N+d],rs);
+            tile[(size_t)token*N+d]=x;
+            if(blockIdx.x==0)m.xn[(size_t)token*D+c*N+d]=x;
+        }
+        __syncthreads();
+        if(active) {
+            #pragma unroll
+            for(int q=0;q<TQ;++q) {
+                const auto weight=unpack8(weights[q]);
+                acc+=dot8u_ptr(weight,tile+(size_t)token*N+(lane+32*q)*8);
+            }
+        }
+        __syncthreads();
+    }
+    if(!active)return;
+    const float sum=warp_sum(acc);
+    if(lane==0) {
+        if(inject)a.inject_out[row]=sum;
+        else {
+            const float x=sum/(float)HC;
+            a.lo[row]=x/(1.0f+__expf(-x));
+        }
+    }
+}
