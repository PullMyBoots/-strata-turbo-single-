+                                                                     const float* __restrict__ hbuf, int C,
+                                                                     const float* __restrict__ gate,
+                                                                     const float* __restrict__ beta,
+                                                                     const float* __restrict__ z,
+                                                                     const float* __restrict__ gamma, float eps,
+                                                                     float* __restrict__ y, int h_k, int h_v, int T,
+                                                                     const int32_t* __restrict__ n_keep, int t_out_begin,
+                                                                     GdnQ81* __restrict__ xq) {
+    __shared__ float sk[2][S], sq[2][S];
+    __shared__ float red_kv[RG][S];
+    __shared__ float red_o[RG][S];
+    __shared__ float wsum[S / 32];
+    const int head = blockIdx.x;
+    const int col = threadIdx.x;
+    const int rg = threadIdx.y;
+    const int qh = head % h_k;
+    const int qk = S * h_k;             // q at [0, qk), k at [qk, 2qk), v at [2qk, ...)
+    const int value_dim = S * h_v;
+    const int n = ALL_OUT ? T : (n_keep ? *n_keep : T);
+    if (n > 0) {
+        if (rg == 0) sk[0][col] = hbuf[qk + qh * S + col];
+        else if (rg == 1 && (ALL_OUT || 0 >= t_out_begin)) sq[0][col] = hbuf[qh * S + col];
+    }
+    const float gam = (rg == 0) ? gamma[col] : 0.0f;
+    float s[RPG];
+    float* base = state + ((size_t) (rg * RPG) * h_v + head) * S + col;
+    const size_t row_stride = (size_t) h_v * S;
+#pragma unroll
+    for (int r = 0; r < RPG; ++r) s[r] = ALL_OUT ? __ldg(&base[r * row_stride]) : base[r * row_stride];
+    for (int t = 0; t < n; ++t) {
+        const int cur = t & 1, nxt = (t + 1) & 1;
+        const float* ht = hbuf + (size_t) t * C;
+        const bool need_out = ALL_OUT || (t >= t_out_begin);
+        __syncthreads();
+        if (t + 1 < n) {
+            const float* ht_next = ht + C;
+            const bool need_next = ALL_OUT || (t + 1 >= t_out_begin);
+            if (rg == 0) sk[nxt][col] = ht_next[qk + qh * S + col];
+            else if (rg == 1 && need_next) sq[nxt][col] = ht_next[qh * S + col];
+        }
+        const float g = __expf(gate[(size_t) t * h_v + head]);
+        float kv = 0.0f;
+#pragma unroll
+        for (int r = 0; r < RPG; ++r) kv = fmaf(s[r], sk[cur][rg * RPG + r], kv);
+        red_kv[rg][col] = kv;
+        __syncthreads();
+        const float kv_col = red_kv[0][col] + red_kv[1][col] + red_kv[2][col] + red_kv[3][col];
+        const float delta = (ht[2 * qk + head * S + col] - g * kv_col) * beta[(size_t) t * h_v + head];
+        if (!need_out) {
+#pragma unroll
+            for (int r = 0; r < RPG; ++r) s[r] = fmaf(g, s[r], sk[cur][rg * RPG + r] * delta);
+            continue;
+        }
+        float o = 0.0f;
+#pragma unroll
+        for (int r = 0; r < RPG; ++r) {
+            s[r] = fmaf(g, s[r], sk[cur][rg * RPG + r] * delta);
+            o = fmaf(s[r], sq[cur][rg * RPG + r], o);
+        }
+        red_o[rg][col] = o;
+        __syncthreads();
+        float oc = 0.0f, sq_part = 0.0f;
+        if (rg == 0) {
+            oc = (red_o[0][col] + red_o[1][col] + red_o[2][col] + red_o[3][col]) * rsqrtf((float) S);
+            sq_part = oc * oc;
+        }
+        // every thread takes the shuffles, as the single-token kernel does: inside the `rg == 0` branch hipcc on
+        // gfx1151 gave another rounding for 3% of the outputs (gdn_parity section 5 on Aurora)
+        for (int o2 = 16; o2 > 0; o2 >>= 1) sq_part += __shfl_xor_sync(0xffffffffu, sq_part, o2);
+        if (rg == 0 && (col & 31) == 0) wsum[col >> 5] = sq_part;
+        __syncthreads();
+        if (rg == 0) {
+            const float ss = wsum[0] + wsum[1] + wsum[2] + wsum[3];
+            const float scale = rsqrtf(ss / (float) S + eps);
+            const float zz = z[(size_t) t * value_dim + head * S + col];
+            const float yv = __fmul_rn(oc * scale * gam, (1.0f / (1.0f + __expf(-zz))));
+            y[(size_t) t * value_dim + head * S + col] = yv;
+            if constexpr (Q) gdn_q8_1_store(xq, (size_t) (t - t_out_begin) * value_dim + head * S + col, yv);
+        }
+    }
+    if (!ALL_OUT && n_keep != nullptr && n > 0) {
+#pragma unroll
+        for (int r = 0; r < RPG; ++r) base[r * row_stride] = s[r];
+    }
+}
+
+} // namespace
+void gdn_step_norm_pipeline(float* state,const float* h,int C,const float* gate,
+    const float* beta,const float* z,const float* gamma,float eps,float* y,
+    int hk,int hv,int T,int tb,void* q8_out,void* stream) {
+    if(!state||!h||!gate||!beta||!z||!gamma||!y||!q8_out||hk<=0||hv%hk||T<1||T>kVerifyMaxT||tb<0||tb>=T) {
+        std::fprintf(stderr,"gdn pipeline: invalid arguments\n");std::exit(2);
+    }
+    const dim3 grid(hv),block(S,RG);
+    if(tb==0)gdn_pipeline_kernel<true,true><<<grid,block,0,static_cast<cudaStream_t>(stream)>>>(state,h,C,gate,beta,z,gamma,eps,y,hk,hv,T,nullptr,tb,static_cast<GdnQ81*>(q8_out));
+    else gdn_pipeline_kernel<false,true><<<grid,block,0,static_cast<cudaStream_t>(stream)>>>(state,h,C,gate,beta,z,gamma,eps,y,hk,hv,T,nullptr,tb,static_cast<GdnQ81*>(q8_out));
+    const auto error=cudaGetLastError();
+    if(error!=cudaSuccess){std::fprintf(stderr,"gdn pipeline: %s\n",cudaGetErrorString(error));std::exit(2);}
+}
+} // namespace strata::kernels
diff --git a/src/kernels/gdn_pipeline_parity.cpp b/src/kernels/gdn_pipeline_parity.cpp
new file mode 100644
--- /dev/null
+++ b/src/kernels/gdn_pipeline_parity.cpp
@@ -0,0 +1,104 @@
+// Compare candidate recurrence outputs, untouched state and Q8 bytes against
+// the incumbent independent two-stage pipeline across every verification size.
+#include "strata/kernels/native_mmvq.hpp"
+#include "strata/kernels/verify_kernels.hpp"
+#include <cuda_runtime.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace strata::kernels;
+namespace {
+void ck(cudaError_t result) {
+    if(result!=cudaSuccess)throw std::runtime_error(cudaGetErrorString(result));
+}
+struct Buffer {
+    void* pointer=nullptr;
+    explicit Buffer(size_t bytes){ck(cudaMalloc(&pointer,bytes));}
+    ~Buffer(){cudaFree(pointer);}
+    float* f(){return static_cast<float*>(pointer);}
+};
+void write(Buffer& buffer,const std::vector<float>& data) {
+    ck(cudaMemcpy(buffer.pointer,data.data(),data.size()*sizeof(float),cudaMemcpyHostToDevice));
+}
+std::vector<unsigned char> read(Buffer& buffer,size_t size) {
+    std::vector<unsigned char> bytes(size);
+    ck(cudaMemcpy(bytes.data(),buffer.pointer,size,cudaMemcpyDeviceToHost));return bytes;
+}
+}
+int main(int argc,char** argv) {
+    try {
+        const bool bench=argc>1&&std::string(argv[1])=="--bench";
+        cudaStream_t stream;ck(cudaStreamCreate(&stream));
+        int failures=0,cases=0;
+        size_t compared=0;
+        std::mt19937 random(20261010);
+        std::normal_distribution<float> normal;
+        for(int hv : {8,48}) {
+            const int hk=hv==48?16:4,N=128*hv,C=256*hk+N;
+            for(int T=1;T<=8;++T)for(int tb : {0,T-1}) {
+                std::vector<float> state(size_t(128)*N),h(size_t(T)*C),z(size_t(T)*N),
+                    gate(size_t(T)*hv),beta(gate.size()),gamma(128);
+                for(auto& value:state)value=0.01f*normal(random);
+                for(auto& value:h)value=0.02f*normal(random);
+                for(auto& value:z)value=normal(random);
+                for(auto& value:gate)value=-0.1f-std::abs(normal(random));
+                for(auto& value:beta)value=0.1f+0.05f*std::abs(normal(random));
+                for(auto& value:gamma)value=1.0f+0.01f*normal(random);
+                Buffer ds(state.size()*4),dh(h.size()*4),dz(z.size()*4),dg(gate.size()*4),
+                    db(beta.size()*4),dm(gamma.size()*4),ref(size_t(T)*N*4),candidate(size_t(T)*N*4),
+                    qr(native_q8_1_bytes(N,T-tb)),qc(native_q8_1_bytes(N,T-tb));
+                write(ds,state);write(dh,h);write(dz,z);write(dg,gate);write(db,beta);write(dm,gamma);
+                ck(cudaMemset(ref.pointer,0xda,size_t(T)*N*4));
+                ck(cudaMemset(candidate.pointer,0xda,size_t(T)*N*4));
+                gdn_step_norm_multi(ds.f(),dh.f(),C,dg.f(),db.f(),dz.f(),dm.f(),1e-6f,
+                    ref.f(),hk,hv,T,nullptr,stream,tb);
+                native_quantize_q8_1(ref.f()+size_t(tb)*N,qr.pointer,N,T-tb,stream);
+                gdn_step_norm_pipeline(ds.f(),dh.f(),C,dg.f(),db.f(),dz.f(),dm.f(),1e-6f,
+                    candidate.f(),hk,hv,T,tb,qc.pointer,stream);
+                ck(cudaStreamSynchronize(stream));
+                auto a=read(ref,size_t(T)*N*4),b=read(candidate,a.size());
+                auto qa=read(qr,native_q8_1_bytes(N,T-tb)),qb=read(qc,qa.size());
+                auto after=read(ds,state.size()*4);
+                const bool equal=a==b&&qa==qb&&std::memcmp(after.data(),state.data(),after.size())==0;
+                compared+=a.size()+qa.size()+after.size();++cases;
+                if(!equal) {
+                    ++failures;
+                    size_t yd=0,qd=0;
+                    for(size_t i=0;i<a.size();++i)yd+=a[i]!=b[i];
+                    for(size_t i=0;i<qa.size();++i)qd+=qa[i]!=qb[i];
+                    std::printf("FAIL hv=%d T=%d tb=%d: output bytes=%zu, quant bytes=%zu, state=%s\n",
+                        hv,T,tb,yd,qd,std::memcmp(after.data(),state.data(),after.size())==0?"same":"changed");
+                }
+                if(bench&&hv==48&&tb==0) {
+                    for(int arm=0;arm<2;++arm) {
+                        cudaEvent_t start,end;ck(cudaEventCreate(&start));ck(cudaEventCreate(&end));
+                        for(int phase=0;phase<2;++phase) {
+                            ck(cudaEventRecord(start,stream));
+                            for(int repeat=0;repeat<200;++repeat) {
+                                if(arm==0) {
+                                    gdn_step_norm_multi(ds.f(),dh.f(),C,dg.f(),db.f(),dz.f(),dm.f(),1e-6f,
+                                        ref.f(),hk,hv,T,nullptr,stream,tb);
+                                    native_quantize_q8_1(ref.f(),qr.pointer,N,T,stream);
+                                } else gdn_step_norm_pipeline(ds.f(),dh.f(),C,dg.f(),db.f(),dz.f(),dm.f(),1e-6f,
+                                    candidate.f(),hk,hv,T,tb,qc.pointer,stream);
+                            }
+                            ck(cudaEventRecord(end,stream));ck(cudaEventSynchronize(end));
+                        }
+                        float milliseconds;ck(cudaEventElapsedTime(&milliseconds,start,end));
+                        std::printf("BENCH T=%d %s %.3f us\n",T,arm?"pipeline":"incumbent",milliseconds*5.0);
+                        ck(cudaEventDestroy(start));ck(cudaEventDestroy(end));
+                    }
+                }
+            }
+        }
+        ck(cudaStreamDestroy(stream));
+        std::printf("gdn_pipeline_parity: %d failures, %d cases, %zu compared bytes\n",failures,cases,compared);
+        return failures?1:0;
+    } catch(const std::exception& error) {std::fprintf(stderr,"%s\n",error.what());return 2;}
+}
diff --git a/src/kernels/mmvq_virtual2_parity.cpp b/src/kernels/mmvq_virtual2_parity.cpp
new file mode 100644
--- /dev/null
+++ b/src/kernels/mmvq_virtual2_parity.cpp
@@ -0,0 +1,54 @@
+// Four-virtual/two-physical warps against the unchanged four-warp MMVQ.
+#include "strata/kernels/native_mmvq.hpp"
+#include <cuda_runtime.h>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+namespace k=strata::kernels;
+void ck(cudaError_t e) { if(e!=cudaSuccess) {std::fprintf(stderr,"CUDA: %s\n",cudaGetErrorString(e));std::exit(2);} }
+template<class T>T* alloc(size_t n) { T* p=nullptr;ck(cudaMalloc((void**)&p,n*sizeof(T)));return p; }
+int main() {
+    setenv("STRATA_MMVQ_ROWS","2",1);
+    k::native_mmvq_set_multi_exact(true);
+    cudaStream_t stream;ck(cudaStreamCreate(&stream));
+    std::mt19937 rng(20261010);std::normal_distribution<float> normal(0,1);
+    int cases=0,failures=0;size_t compared=0;
+    for(int type:{2,6,8,12,13,14,20,23,42})for(int N:{2560,6144}) {
+        constexpr int M=67;
+        const int block_values=type==42?64:type==12||type==13||type==14||type==23?256:32;
+        const size_t bs=k::native_mmvq_weight_bytes(type,block_values,1);
+        const size_t bytes=k::native_mmvq_weight_bytes(type,N,M);
+        std::vector<unsigned char> w(bytes);for(auto& v:w)v=unsigned(rng())&255;
+        const uint16_t scale=0x1800,minimum=0x1000;
+        for(size_t i=0;i<bytes;i+=bs) {
+            std::memcpy(w.data()+i+(type==14?bs-2:0),&scale,2);
+            if(type==12||type==13)std::memcpy(w.data()+i+2,&minimum,2);
+        }
+        std::vector<float> x(size_t(8)*N);for(auto&v:x)v=normal(rng);
+        auto *dw=alloc<unsigned char>(bytes),*dq=alloc<unsigned char>(k::native_q8_1_bytes(N,8));
+        auto *dx=alloc<float>(x.size()),*da=alloc<float>(8*M),*db=alloc<float>(8*M);
+        ck(cudaMemcpy(dw,w.data(),bytes,cudaMemcpyHostToDevice));
+        ck(cudaMemcpy(dx,x.data(),x.size()*4,cudaMemcpyHostToDevice));
+        k::native_quantize_q8_1(dx,dq,N,8,stream);
+        for(int T=5;T<=8;++T) {
+            k::native_mmvq_set_virtual2(false);k::native_mmvq(type,dw,dq,da,N,M,T,stream);
+            k::native_mmvq_set_virtual2(true);k::native_mmvq(type,dw,dq,db,N,M,T,stream);
+            ck(cudaStreamSynchronize(stream));
+            std::vector<float>a(T*M),b(T*M);
+            ck(cudaMemcpy(a.data(),da,a.size()*4,cudaMemcpyDeviceToHost));
+            ck(cudaMemcpy(b.data(),db,b.size()*4,cudaMemcpyDeviceToHost));
+            bool finite=true;for(float value:b)finite=finite&&std::isfinite(value);
+            if(!finite||std::memcmp(a.data(),b.data(),a.size()*4)!=0) {
+                ++failures;std::printf("FAIL type=%d N=%d T=%d finite=%d\n",type,N,T,finite);
+            }
+            compared+=a.size()*4;++cases;
+        }
+        cudaFree(dw);cudaFree(dq);cudaFree(dx);cudaFree(da);cudaFree(db);
+    }
+    cudaStreamDestroy(stream);
+    std::printf("mmvq_virtual2_parity: %d cases, %zu bytes, %d failures\n",cases,compared,failures);
+    return failures?1:0;
+}
diff --git a/src/kernels/moe_mixed_parity.cpp b/src/kernels/moe_mixed_parity.cpp
new file mode 100644
--- /dev/null
+++ b/src/kernels/moe_mixed_parity.cpp
@@ -0,0 +1,77 @@
+// Mixed CPU/GPU reduction against the incumbent materialize/add/reduce path.
+// Poison unused rows so an invalid eager read cannot pass by coincidence.
+#include "strata/kernels/native_moe.hpp"
+#include "strata/kernels/s2_expert_grouped.hpp"
+#include <cuda_runtime.h>
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <numeric>
+#include <random>
+#include <vector>
+
+namespace k = strata::kernels;
+void ck(cudaError_t e) {
+    if (e != cudaSuccess) {
+        std::fprintf(stderr,"CUDA: %s\n",cudaGetErrorString(e)); std::exit(2);
+    }
+}
+template<class T> T* alloc(size_t count) {
+    T* p = nullptr; ck(cudaMalloc((void**)&p,count*sizeof(T))); return p;
+}
+template<class T> void upload(T* dst,const std::vector<T>& src) {
+    ck(cudaMemcpy(dst,src.data(),src.size()*sizeof(T),cudaMemcpyHostToDevice));
+}
+int main() {
+    cudaStream_t stream; ck(cudaStreamCreate(&stream));
+    std::mt19937 rng(20261010); std::normal_distribution<float> random(0,1);
+    size_t compared=0; int cases=0, failures=0;
+    for (int T=1;T<=8;++T) for(int K:{1,10,15}) for(int N:{33,2560}) {
+        const int rows=T*K; const size_t count=size_t(rows)*N, out_count=size_t(T)*N;
+        float *mapped=nullptr,*device_mapped=nullptr;
+        ck(cudaHostAlloc((void**)&mapped,count*4,cudaHostAllocMapped));
+        ck(cudaHostGetDevicePointer((void**)&device_mapped,mapped,0));
+        float *parts=alloc<float>(count),*hits=alloc<float>(count),*weights=alloc<float>(rows),
+              *shared=alloc<float>(out_count),*old=alloc<float>(out_count),*fused=alloc<float>(out_count);
+        int32_t *dst=alloc<int32_t>(rows),*n_hits=alloc<int32_t>(1);
+        std::vector<float> cpu(count),gpu(count),w(rows),sh(out_count),a(out_count),b(out_count);
+        std::vector<int32_t> order(rows); std::iota(order.begin(),order.end(),0);
+        for(int round=0;round<4;++round) {
+            std::shuffle(order.begin(),order.end(),rng);
+            int nh=round==0?0:round==1?1:round==2?rows/2:rows;
+            ck(cudaMemcpy(dst,order.data(),rows*4,cudaMemcpyHostToDevice));
+            ck(cudaMemcpy(n_hits,&nh,4,cudaMemcpyHostToDevice));
+            std::vector<bool> is_hit(rows,false);
+            for(int i=0;i<nh;++i)is_hit[order[i]]=true;
+            for(int r=0;r<rows;++r)for(int c=0;c<N;++c) {
+                const size_t i=size_t(r)*N+c;
+                cpu[i]=is_hit[r]?0.0f:random(rng);
+                gpu[i]=is_hit[r]?random(rng):std::numeric_limits<float>::quiet_NaN();
+                mapped[i]=is_hit[r]?std::numeric_limits<float>::quiet_NaN():cpu[i];
+                if(c%97==0) { // signed zeros must follow the old hit-add rule
+                    if(is_hit[r])gpu[i]=-0.0f; else mapped[i]=cpu[i]=-0.0f;
+                }
+            }
+            for(auto& value:w)value=random(rng);
+            for(auto& value:sh)value=random(rng);
+            upload(parts,cpu); upload(hits,gpu); upload(weights,w); upload(shared,sh);
+            k::moe_hit_add(parts,hits,dst,n_hits,rows,N,stream);
+            k::native_moe_combine_multi(parts,weights,shared,old,N,K,T,stream);
+            k::native_moe_combine_mixed_multi(device_mapped,hits,dst,n_hits,weights,shared,fused,N,K,T,stream);
+            ck(cudaStreamSynchronize(stream));
+            ck(cudaMemcpy(a.data(),old,out_count*4,cudaMemcpyDeviceToHost));
+            ck(cudaMemcpy(b.data(),fused,out_count*4,cudaMemcpyDeviceToHost));
+            if(std::memcmp(a.data(),b.data(),out_count*4)!=0) {
+                ++failures; std::printf("FAIL T=%d K=%d N=%d hits=%d\n",T,K,N,nh);
+            }
+            compared+=out_count*4; ++cases;
+        }
+        cudaFreeHost(mapped); cudaFree(parts); cudaFree(hits); cudaFree(weights);
+        cudaFree(shared); cudaFree(old); cudaFree(fused); cudaFree(dst); cudaFree(n_hits);
+    }
+    cudaStreamDestroy(stream);
+    std::printf("moe_mixed_parity: %d cases, %zu bytes, %d failures\n",cases,compared,failures);
+    return failures?1:0;
+}
diff --git a/src/kernels/hc_norm_down_parity.cpp b/src/kernels/hc_norm_down_parity.cpp
new file mode 100644
--- /dev/null
+++ b/src/kernels/hc_norm_down_parity.cpp
@@ -0,0 +1,145 @@
+// Exact fused normalization/down projection against the selected incumbent HC read.
+// Adapted from the pinned upstream fused_gr_bench.cpp (MIT).
+// Compare R, xn, lo, rs, inject and mixed, including graph replay.
+// Usage: hc_norm_down_parity [iterations] [minimum T] [maximum T]
+#include "strata/kernels/fused_gr.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace K = strata::kernels;
+
+static uint16_t bf16(float x) {
+    uint32_t u;
+    std::memcpy(&u, &x, 4);
+    return (uint16_t) ((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+int main(int argc, char** argv) {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    const int iters = argc > 1 ? std::atoi(argv[1]) : 500;
+    const int t_lo = argc > 2 ? std::atoi(argv[2]) : 1, t_hi = argc > 3 ? std::atoi(argv[3]) : 8;
+    if (iters < 1 || t_lo < 1 || t_hi > 8 || t_lo > t_hi) return 2;
+    K::fused_gr_set_norm_down(false);
+    K::fused_gr_check();
+    const int N = 2560, HC = 4, D = N * HC, LR = 320, TM = K::kFusedGrMaxT;
+    std::mt19937 rng(7);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    auto fill = [&](std::vector<float>& v, float sc) { for (auto& x : v) x = sc * nd(rng); };
+    std::vector<float> R((size_t) TM * D), bo((size_t) TM * N), inj((size_t) TM * HC), wn(D);
+    fill(R, 1.0f); fill(bo, 0.5f); fill(inj, 1.0f); fill(wn, 0.3f);
+    for (auto& x : wn) x += 1.0f;
+    std::vector<uint16_t> wd((size_t) LR * D), wu((size_t) D * LR), wi((size_t) HC * D);
+    for (auto& x : wd) x = bf16(0.02f * nd(rng));
+    for (auto& x : wu) x = bf16(0.05f * nd(rng));
+    for (auto& x : wi) x = bf16(0.02f * nd(rng));
+    float *dR, *dR0, *dbo, *dinj, *dwn, *dxn, *dlo, *drs, *dio, *dmix;
+    uint16_t *dwd, *dwu, *dwi;
+    cudaMalloc((void**) &dR, R.size() * 4);
+    cudaMalloc((void**) &dR0, R.size() * 4);
+    cudaMemcpy(dR0, R.data(), R.size() * 4, cudaMemcpyHostToDevice);
+    cudaMalloc((void**) &dbo, bo.size() * 4);
+    cudaMalloc((void**) &dinj, inj.size() * 4);
+    cudaMalloc((void**) &dwn, wn.size() * 4);
+    cudaMalloc((void**) &dxn, (size_t) TM * D * 4);
+    cudaMalloc((void**) &dlo, (size_t) TM * LR * 4);
+    cudaMalloc((void**) &drs, (size_t) TM * HC * 4);
+    cudaMalloc((void**) &dio, (size_t) TM * HC * 4);
+    cudaMalloc((void**) &dmix, (size_t) TM * N * 4);
+    cudaMalloc((void**) &dwd, wd.size() * 2);
+    cudaMalloc((void**) &dwu, wu.size() * 2);
+    cudaMalloc((void**) &dwi, wi.size() * 2);
+    cudaMemcpy(dbo, bo.data(), bo.size() * 4, cudaMemcpyHostToDevice);
+    cudaMemcpy(dinj, inj.data(), inj.size() * 4, cudaMemcpyHostToDevice);
+    cudaMemcpy(dwn, wn.data(), wn.size() * 4, cudaMemcpyHostToDevice);
+    cudaMemcpy(dwd, wd.data(), wd.size() * 2, cudaMemcpyHostToDevice);
+    cudaMemcpy(dwu, wu.data(), wu.size() * 2, cudaMemcpyHostToDevice);
+    cudaMemcpy(dwi, wi.data(), wi.size() * 2, cudaMemcpyHostToDevice);
+    cudaStream_t s;
+    cudaStreamCreate(&s);
+    cudaEvent_t e0, e1;
+    cudaEventCreate(&e0);
+    cudaEventCreate(&e1);
+    int failures = 0;
+    for (int T = t_lo; T <= t_hi; ++T)
+        for (int apply = 0; apply < 2; ++apply)
+            for (int inject = 0; inject < 2; ++inject) {
+                K::FusedGrArgs a[TM];
+                for (int t = 0; t < T; ++t) {
+                    a[t].R = dR + (size_t) t * D; a[t].R_out = dR + (size_t) t * D; a[t].apply = apply;
+                    a[t].bo_prev = dbo + (size_t) t * N; a[t].inj_prev = dinj + (size_t) t * HC;
+                    a[t].w_norm = dwn; a[t].w_down = dwd; a[t].w_up = dwu; a[t].w_inject = inject ? dwi : nullptr;
+                    a[t].lo = dlo + (size_t) t * LR; a[t].rs = drs + (size_t) t * HC;
+                    a[t].inject_out = dio + (size_t) t * HC; a[t].mixed = dmix + (size_t) t * N;
+                }
+                std::vector<float> out[2];
+                for (int f = 0; f < 2; ++f) {
+                    cudaMemcpy(dR, R.data(), R.size() * 4, cudaMemcpyHostToDevice);
+                    cudaMemset(dxn, 0xff, (size_t) TM * D * 4);
+                    cudaMemset(dlo, 0xff, (size_t) TM * LR * 4);
+                    cudaMemset(drs, 0xff, (size_t) TM * HC * 4);
+                    cudaMemset(dio, 0xff, (size_t) TM * HC * 4);
+                    cudaMemset(dmix, 0xff, (size_t) TM * N * 4);
+                    K::fused_gr_set_norm_down(f != 0);
+                    K::fused_gr_read_multi(a, T, dxn, s);
+                    cudaStreamSynchronize(s);
+                    auto& o = out[f];
+                    o.resize((size_t) TM * (D + D + LR + HC + HC + N));
+                    float* p = o.data();
+                    cudaMemcpy(p, dR, (size_t) TM * D * 4, cudaMemcpyDeviceToHost); p += (size_t) TM * D;
+                    cudaMemcpy(p, dxn, (size_t) TM * D * 4, cudaMemcpyDeviceToHost); p += (size_t) TM * D;
+                    cudaMemcpy(p, dlo, (size_t) TM * LR * 4, cudaMemcpyDeviceToHost); p += (size_t) TM * LR;
+                    cudaMemcpy(p, drs, (size_t) TM * HC * 4, cudaMemcpyDeviceToHost); p += (size_t) TM * HC;
+                    cudaMemcpy(p, dio, (size_t) TM * HC * 4, cudaMemcpyDeviceToHost); p += (size_t) TM * HC;
+                    cudaMemcpy(p, dmix, (size_t) TM * N * 4, cudaMemcpyDeviceToHost);
+                }
+                const bool same = std::memcmp(out[0].data(), out[1].data(), out[0].size() * 4) == 0;
+                double us[2] = {1e30, 1e30};
+                for (int f = 0; f < 2; ++f) {
+                    K::fused_gr_set_norm_down(f != 0);
+                    cudaGraph_t graph=nullptr;
+                    cudaGraphExec_t exec=nullptr;
+                    if(cudaStreamBeginCapture(s,cudaStreamCaptureModeThreadLocal)!=cudaSuccess)return 2;
+                    cudaMemcpyAsync(dR,dR0,R.size()*4,cudaMemcpyDeviceToDevice,s);
+                    K::fused_gr_read_multi(a,T,dxn,s);
+                    if(cudaStreamEndCapture(s,&graph)!=cudaSuccess ||
+                       cudaGraphInstantiate(&exec,graph,nullptr,nullptr,0)!=cudaSuccess)return 2;
+                    for(int round=0;round<3;++round) {
+                        for(int i=0;i<20;++i)cudaGraphLaunch(exec,s);
+                        cudaEventRecord(e0,s);
+                        for(int i=0;i<iters;++i)cudaGraphLaunch(exec,s);
+                        cudaEventRecord(e1,s);
+                        if(cudaEventSynchronize(e1)!=cudaSuccess)return 2;
+                        float ms=0;
+                        cudaEventElapsedTime(&ms,e0,e1);
+                        us[f]=std::fmin(us[f],1e3*ms/iters);
+                    }
+                    // Every replay starts from the identical residual input.
+                    std::vector<float> replay(out[f].size());
+                    float* p=replay.data();
+                    cudaMemcpy(p,dR,(size_t)TM*D*4,cudaMemcpyDeviceToHost);p+=(size_t)TM*D;
+                    cudaMemcpy(p,dxn,(size_t)TM*D*4,cudaMemcpyDeviceToHost);p+=(size_t)TM*D;
+                    cudaMemcpy(p,dlo,(size_t)TM*LR*4,cudaMemcpyDeviceToHost);p+=(size_t)TM*LR;
+                    cudaMemcpy(p,drs,(size_t)TM*HC*4,cudaMemcpyDeviceToHost);p+=(size_t)TM*HC;
+                    cudaMemcpy(p,dio,(size_t)TM*HC*4,cudaMemcpyDeviceToHost);p+=(size_t)TM*HC;
+                    cudaMemcpy(p,dmix,(size_t)TM*N*4,cudaMemcpyDeviceToHost);
+                    if(std::memcmp(replay.data(),out[f].data(),replay.size()*4)!=0) {
+                        std::printf("T %d apply %d inject %d graph replay differs\n",T,apply,inject);
+                        ++failures;
+                    }
+                    cudaGraphExecDestroy(exec);cudaGraphDestroy(graph);
+                }
+                std::printf("T %d apply %d inject %d | control %6.1f us  fused %6.1f us | %s\n", T, apply, inject, us[0], us[1],
+                            same ? "bitwise equal" : "DIFFERS");
+                if (!same) ++failures;
+            }
+    std::printf("hc_norm_down_parity: %d differing\n", failures);
+    return failures ? 1 : 0;
+}
